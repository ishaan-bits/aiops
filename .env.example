# ── Frontend (Next.js) ──────────────────────────────────────────────
# Server-side rewrite target: the browser calls /api/* on this origin and
# Next.js proxies those requests to the FastAPI backend (keeps cookies
# first-party, so no CORS is needed).
API_PROXY_URL=http://localhost:8000

# GitHub repository link shown on the landing page.
NEXT_PUBLIC_GITHUB_URL=https://github.com/ishaan-bits/aiops
