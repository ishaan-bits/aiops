# ── Frontend (Next.js) ──────────────────────────────────────────────
# Public API URL the browser uses to reach the backend.
# In production this should be your deployed FastAPI URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Storage credentials (public, safe for browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Backend (FastAPI) ───────────────────────────────────────────────
# Ollama endpoint for local AI inference (optional in production).
OLLAMA_URL=http://localhost:11434

# Comma-separated list of allowed CORS origins (JSON array string).
CORS_ORIGINS=["http://localhost:3000"]

# Supabase Storage credentials (service key for server-side downloads).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
