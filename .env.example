# ── Frontend (Next.js) ──────────────────────────────────────────────
# Public API URL the browser uses to reach the backend.
# In production this should be your deployed FastAPI URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Backend (FastAPI) ───────────────────────────────────────────────
# Ollama endpoint for local AI inference (optional in production).
OLLAMA_URL=http://localhost:11434

# Comma-separated list of allowed CORS origins (JSON array string).
CORS_ORIGINS=["http://localhost:3000"]

# Supabase credentials (service role key for server-side operations).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
